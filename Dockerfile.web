FROM node:22-alpine AS build

WORKDIR /app

COPY web/package*.json ./

RUN npm ci

COPY web/ ./

RUN npm run build


FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY web/package*.json ./

RUN npm ci --omit=dev

COPY --from=build /app/build ./build
COPY --from=build /app/public ./public

RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["npm", "start"]
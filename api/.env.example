NODE_ENV=development
PORT=4000

# Where the web app lives. Does two jobs: it is the CORS allow-list, and it is
# the base of every link in every email we send. Absolute, no trailing slash.
# In production this is your real domain: https://taskforge.yourcompany.com
# Leaving it on localhost in production is refused at startup — the invitation
# would arrive with a link nobody but you could open.
WEB_ORIGIN=http://localhost:5173

# Set to false once your workspace exists. Team members join by invitation,
# not by signing up, so leaving this open only invites strangers to create
# organisations on your server.
ALLOW_REGISTRATION=true

# Port 5433, not 5432: a native PostgreSQL install commonly owns 5432 on
# Windows, and both it and Docker can bind the port without either erroring —
# you just silently connect to the wrong server. The container is mapped to
# 5433 in docker-compose.yml to stay out of its way.
#
# 127.0.0.1, not localhost: on Windows `localhost` resolves to ::1 first.
DATABASE_URL=postgresql://taskforge:taskforge@127.0.0.1:5433/taskforge?schema=public

# Two different secrets. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=dev-only-refresh-secret-min-32-characters
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

LOG_LEVEL=debug
LOG_PRETTY=true

# ══════════════════════════════════════════════════════════════════════════
#  Email — invitations, password resets, deadline reminders, digests
# ══════════════════════════════════════════════════════════════════════════
#
# `console` prints the message to the server log and sends nothing. It is the
# default so local development needs no mail account — and it is refused in
# production, because an app that silently sends nothing looks like working
# software right up until someone waits for an invitation that never arrives.

EMAIL_TRANSPORT=console

# Links in emails come from WEB_ORIGIN at the top of this file. There is no
# separate APP_URL — there was, it meant the same thing, and the API now
# refuses to start if you set it.

# The From address. Must be a domain you are allowed to send as, or your mail
# will be marked as spam regardless of the provider.
EMAIL_FROM=TaskForge <no-reply@yourdomain.com>

# Optional. Where replies go, if that differs from the sender.
# EMAIL_REPLY_TO=support@yourdomain.com

# ── SMTP, when EMAIL_TRANSPORT=smtp ──────────────────────────────────────
#
# Port 587 with STARTTLS is the usual choice; 465 is implicit TLS. SMTP_SECURE
# is inferred from the port and only needs setting if your provider is unusual.
# Getting it wrong produces a connection that hangs rather than one that fails.

# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_SECURE=false

# ── Provider settings, for reference ──────────────────────────────────────
#
# Resend        SMTP_HOST=smtp.resend.com        PORT=587   USER=resend
# SendGrid      SMTP_HOST=smtp.sendgrid.net      PORT=587   USER=apikey
# Postmark      SMTP_HOST=smtp.postmarkapp.com   PORT=587   USER=<server token>
# Amazon SES    SMTP_HOST=email-smtp.<region>.amazonaws.com  PORT=587
# Mailgun       SMTP_HOST=smtp.mailgun.org       PORT=587   USER=postmaster@<domain>
#
# Gmail and Outlook personal accounts will work for a handful of messages and
# then rate-limit or block you. They are not a transactional email service —
# use one of the above before you invite a real client.
#
# ── Deliverability ────────────────────────────────────────────────────────
#
# Whichever provider you choose, add these DNS records for your sending domain
# or invitations will land in spam:
#
#   SPF     TXT   "v=spf1 include:<provider spf host> ~all"
#   DKIM    CNAME (or TXT) — the provider gives you the exact records
#   DMARC   TXT   "v=DMARC1; p=none; rua=mailto:dmarc@yourdomain.com"
#
# Start DMARC at p=none, read the reports for a fortnight, then tighten to
# quarantine. Going straight to reject with a misconfigured SPF silently
# discards your own mail.

# ── Web push ────────────────────────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# Keep them. Rotating the public key invalidates every existing subscription
# and every user has to grant permission again.
#
# Both or neither — one alone cannot sign a push, and the API refuses to start
# with only one set. Leaving both empty simply disables push: notifications are
# still written and the badge still counts, no phone rings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if we misbehave. Must be a real address.
VAPID_SUBJECT=mailto:admin@yourdomain.com
